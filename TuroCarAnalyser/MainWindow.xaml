<Window x:Class="TuroCarAnalyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Turo Car Analyser"
        Width="1320"
        Height="860"
        MinWidth="1060"
        MinHeight="720"
        Background="#F3EFE8"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D8CBBE" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFDFC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#213F52" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEAF0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5A544D" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#C07045" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D9CDBF" />
        <SolidColorBrush x:Key="SidePanelBrush" Color="#EEF5F7" />
        <SolidColorBrush x:Key="SidePanelBorderBrush" Color="#9DB8C4" />
        <SolidColorBrush x:Key="InsightCardBrush" Color="#FFF9F2" />
        <SolidColorBrush x:Key="InsightCardBorderBrush" Color="#E2D4C6" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <Style x:Key="SidePanelStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Background" Value="{StaticResource SidePanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SidePanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SectionEyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SectionBodyStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="InsightCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InsightCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InsightCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFDFC" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF5E8" />
            <Setter Property="Foreground" Value="#1E2D38" />
            <Setter Property="BorderBrush" Value="#FFF5E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#F4EEE6"
                                BorderBrush="#DDCFC1"
                                BorderThickness="1"
                                CornerRadius="14">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFF9F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnalysisTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#F7F1E8"
                                BorderBrush="#E1D4C6"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#DCEAF0" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#9DB8C4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFDFC" />
            <Setter Property="BorderBrush" Value="#E6DACA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AlternatingRowBackground" Value="#FAF6F0" />
            <Setter Property="RowBackground" Value="#FFFDFC" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="MinColumnWidth" Value="120" />
            <Setter Property="MaxColumnWidth" Value="280" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F6EFE7" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E7DCCD" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#26343C" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEAF0" />
                    <Setter Property="Foreground" Value="#213F52" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#EFE4D8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F8FA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEAF0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="PageScrollViewer"
                  PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,14" Padding="24,20" CornerRadius="28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#29485A" Offset="0" />
                    <GradientStop Color="#666252" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="#FFF8EE"
                               FontSize="30"
                               FontWeight="Bold"
                               Text="Turo Car Analyser" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#E3EBED"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Text="Research Turo markets, review ranked opportunities, and pressure-test a vehicle before you buy it." />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="#F7EAD9"
                               FontSize="13"
                               Text="{Binding ImportSummary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Right">
                    <TextBlock Foreground="#F7EAD9"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="Session" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#DDE8EB"
                               FontSize="13"
                               Text="Keep file actions in the corner so the workspace stays focused."
                               TextWrapping="Wrap" />
                    <Button x:Name="SessionMenuButton"
                            Margin="0,14,0,0"
                            Click="SessionMenuButton_Click"
                            Content="Session menu"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Add CSV files" Click="ImportButton_Click" />
                                <MenuItem Header="Clear session" Click="ClearButton_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Listings analysed" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding ListingCountText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Markets in view" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding MarketCountText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Avg daily price" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding AverageDailyPriceText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Margin="0,0,10,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Avg utilization" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding AverageUtilizationText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Avg monthly revenue" />
                    <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding AverageMonthlyRevenueText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="680" />
                <RowDefinition Height="16" />
                <RowDefinition Height="780" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,16" Style="{StaticResource SidePanelStyle}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource AccentBrush}" CornerRadius="24,0,0,24" />

                        <StackPanel Grid.Column="1" Margin="18">
                            <TextBlock Style="{StaticResource SectionEyebrowStyle}" Text="Pop-out side filters" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="View filters" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource SectionBodyStyle}"
                                       Text="{Binding StatusMessage}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Market" />
                                    <ComboBox Margin="0,6,0,0"
                                              ItemsSource="{Binding AvailableMarkets}"
                                              SelectedItem="{Binding SelectedMarket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Source" />
                                    <ComboBox Margin="0,6,0,0"
                                              ItemsSource="{Binding AvailableSources}"
                                              SelectedItem="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Style="{StaticResource SectionEyebrowStyle}" Text="Decision summary" />
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Decision desk" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource SectionBodyStyle}"
                                           Text="The market tables sit above; use this section for the current thesis, notes, and ROI check." />
                            </StackPanel>

                            <Border DockPanel.Dock="Right"
                                    Padding="12,10"
                                    Background="#F7F1E8"
                                    BorderBrush="#E2D6C8"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <StackPanel Width="220">
                                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Current candidate" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedListingTitleText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               Text="{Binding SelectedListingHostText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <TabControl Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource SidebarTabItemStyle}">
                            <TabItem Header="Summary">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="LeftPanelContent">
                            <Border Padding="14,12"
                                    Background="#214259"
                                    CornerRadius="18"
                                    BorderBrush="#163041"
                                    BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#D8E8EE"
                                               Text="Decision Summary" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#FFF8EE"
                                               Text="What stands out" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,18"
                                    Padding="16"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="#9CB8C2"
                                    BorderThickness="1.5"
                                    CornerRadius="20">
                                <StackPanel>
                                    <TextBlock Foreground="#35566B"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Text="Best vehicle type right now" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Text="{Binding BestVehicleTypeText}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#35566B"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding SourceCountText, StringFormat=Across {0} source(s) in the current filter}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,0,18"
                                    Padding="16"
                                    Background="#FFFDFC"
                                    BorderBrush="#E4D6C8"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Foreground="#35566B"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Text="Recommended model to target" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Text="{Binding RecommendedModelText}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource SectionBodyStyle}"
                                                   Text="{Binding RecommendationHeadlineText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Foreground="#35566B"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Text="Best visible candidate" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Text="{Binding RecommendedCandidateText}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource HighlightBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding RecommendedCandidateScoreText}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource SectionBodyStyle}"
                                                   Text="{Binding RecommendedCandidateReasonText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,18"
                                    Padding="16"
                                    Background="#F7F1E8"
                                    BorderBrush="#E2D6C8"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <StackPanel>
                                    <TextBlock Foreground="#35566B"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Text="Historical knowledge base" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Text="{Binding KnowledgeBaseStatusText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource SectionBodyStyle}"
                                               Text="{Binding HistoricalComparisonText}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding NarrativeInsights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsightCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{StaticResource HighlightBrush}"
                                                        CornerRadius="8" />

                                                <TextBlock Grid.Column="2"
                                                           Foreground="#2F2C27"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,2,0,0"
                                    Padding="16"
                                    Background="#FFF8EE"
                                    BorderBrush="#E4D6C8"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Selected listing context" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="{Binding SelectedListingTitleText}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource SectionBodyStyle}"
                                               Text="{Binding SelectedListingContextText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Notes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <Border Margin="0,14,0,0"
                                    Background="#FFFDF9"
                                    BorderBrush="#D6B79E"
                                    BorderThickness="1.5"
                                    CornerRadius="22"
                                    Padding="18">
                                <StackPanel x:Name="ImportNotesSection">
                                    <TextBlock FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource HighlightBrush}"
                                               Text="Import notes" />
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="#574E44"
                                               Text="{Binding ImportNotesText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="ROI">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Margin="0,14,0,0"
                                    Padding="16"
                                    Background="#FFFFFF"
                                    BorderBrush="#8EB0BD"
                                    BorderThickness="1.5"
                                    CornerRadius="20">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="ROI calculator" />
                                        <Button DockPanel.Dock="Right"
                                                Click="ResetAssumptionsButton_Click"
                                                Content="Reset assumptions"
                                                Style="{StaticResource SmallButtonStyle}" />
                                    </DockPanel>

                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"
                                               Text="These assumptions apply to the currently selected listing and estimate deal quality after Turo fees, financing, and operating costs."
                                               TextWrapping="Wrap" />

                                    <UniformGrid Margin="0,14,0,0" Columns="2">
