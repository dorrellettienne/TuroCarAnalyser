                                <DataGridTextColumn Header="Utilization" Binding="{Binding AverageUtilization, StringFormat={}{0:P0}}" Width="0.8*" />
                                <DataGridTextColumn Header="Trend" Binding="{Binding TrendLabel}" Width="0.8*" />
                                <DataGridTextColumn Header="Trend %" Binding="{Binding TrendPercent, StringFormat={}{0:+0;-0;0}%}" Width="0.8*" />
                                <DataGridTextColumn Header="Seasonality" Binding="{Binding SeasonalityScore, StringFormat={}{0:N0}}" Width="0.8*" />
                                <DataGridTextColumn Header="History" Binding="{Binding RevenueSparkline}" Width="0.8*" />
                                <DataGridTextColumn Header="Read" Binding="{Binding Takeaway}" Width="1.6*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Comps" ToolTip="Comparables">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Margin="0,0,0,12"
                                    Padding="14"
                                    Background="#F8FBFB"
                                    BorderBrush="#D7E6EA"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource HighlightBrush}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Text="Comparable vehicles for the selected candidate" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Text="{Binding SelectedListingTitleText}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding ComparableSummaryText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ComparableVehicles}" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleName}" Width="1.5*" />
                                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="0.8*" />
                                    <DataGridTextColumn Header="Market" Binding="{Binding Market}" Width="1*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding VehicleType}" Width="1*" />
                                    <DataGridTextColumn Header="Trim" Binding="{Binding Trim}" Width="0.8*" />
                                    <DataGridTextColumn Header="Trans." Binding="{Binding Transmission}" Width="0.7*" />
                                    <DataGridTextColumn Header="Daily" Binding="{Binding DailyPrice, StringFormat={}{0:N0}}" Width="0.8*" />
                                    <DataGridTextColumn Header="Utilization" Binding="{Binding UtilizationRate, StringFormat={}{0:P0}}" Width="0.9*" />
                                    <DataGridTextColumn Header="Revenue / mo" Binding="{Binding EstimatedMonthlyRevenue, StringFormat={}{0:N0}}" Width="1.1*" />
                                    <DataGridTextColumn Header="Trips" Binding="{Binding Trips, StringFormat={}{0:N0}}" Width="0.6*" />
                                    <DataGridTextColumn Header="Similarity" Binding="{Binding SimilarityScore, StringFormat={}{0:N1}}" Width="0.8*" />
                                    <DataGridTextColumn Header="Why comparable" Binding="{Binding SimilarityLabel}" Width="1.6*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Listings">
                        <DataGrid ItemsSource="{Binding VisibleListings}"
                                  SelectedItem="{Binding SelectedListing, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vehicle" Binding="{Binding DisplayName}" Width="1.5*" />
                                <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="1*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding VehicleType}" Width="1*" />
                                <DataGridTextColumn Header="Market" Binding="{Binding Market}" Width="1*" />
                                <DataGridTextColumn Header="Daily" Binding="{Binding DailyPrice, StringFormat={}{0:N0}}" Width="0.8*" />
                                <DataGridTextColumn Header="Utilization" Binding="{Binding UtilizationRate, StringFormat={}{0:P0}}" Width="0.9*" />
                                <DataGridTextColumn Header="Revenue / mo" Binding="{Binding EstimatedMonthlyRevenue, StringFormat={}{0:N0}}" Width="1.1*" />
                                <DataGridTextColumn Header="Trips" Binding="{Binding Trips, StringFormat={}{0:N0}}" Width="0.7*" />
                                <DataGridTextColumn Header="Favorites" Binding="{Binding Favorites, StringFormat={}{0:N0}}" Width="0.8*" />
                                <DataGridTextColumn Header="Reviews" Binding="{Binding Reviews, StringFormat={}{0:N0}}" Width="0.8*" />
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="0.9*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                </Grid>
            </Border>
        </Grid>

            <TextBlock Grid.Row="4"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Text="Desktop MVP note: host, discount, delivery, and monthly-history insights depend on what the source export includes, and ROI still assumes revenue scales roughly with utilization."
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Window>
