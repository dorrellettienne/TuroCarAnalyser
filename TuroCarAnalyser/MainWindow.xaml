                                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Yield / cash-on-cash" />
                                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" Text="{Binding RoiAnnualYieldText}" />
                                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding RoiCashOnCashText}" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <TextBlock Margin="0,14,0,0"
                                                       Foreground="#4E4A43"
                                                       FontSize="13"
                                                       Text="{Binding RoiSummaryText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
            </Grid>

            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
