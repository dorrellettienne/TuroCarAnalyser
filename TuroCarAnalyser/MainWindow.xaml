                                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Break-even utilization" />
                                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" Text="{Binding RoiBreakEvenUtilizationText}" />
                                                    </StackPanel>
                                                </Border>
