<Window x:Class="TuroCarAnalyser.Views.ImportMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Mapping Preview"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F3EC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="28"
                   FontWeight="Bold"
                   Foreground="#214259"
                   Text="Mapping Preview" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,18"
                   Foreground="#5E5A54"
                   FontSize="14"
                   Text="{Binding IntroText}"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Padding="16"
                Background="#FFFDF9"
                BorderBrush="#DFCDB4"
                BorderThickness="1"
                CornerRadius="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <TextBlock FontWeight="Bold" Foreground="#214259" Text="Internal Field" />
                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="#214259" Text="CSV Column" />
                <TextBlock Grid.Column="2" FontWeight="Bold" Foreground="#214259" Text="Status" />

                <TextBlock Grid.Row="1" Margin="0,12,12,0" VerticalAlignment="Center" Text="Title" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding TitleColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding TitleStatusText}" />

                <TextBlock Grid.Row="2" Margin="0,12,12,0" VerticalAlignment="Center" Text="Make" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding MakeColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding MakeStatusText}" />

                <TextBlock Grid.Row="3" Margin="0,12,12,0" VerticalAlignment="Center" Text="Model" />
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding ModelColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding ModelStatusText}" />

                <TextBlock Grid.Row="4" Margin="0,12,12,0" VerticalAlignment="Center" Text="Year" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding YearColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding YearStatusText}" />

                <TextBlock Grid.Row="5" Margin="0,12,12,0" VerticalAlignment="Center" Text="Daily Price" />
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding DailyPriceColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding DailyPriceStatusText}" />

                <TextBlock Grid.Row="6" Margin="0,12,12,0" VerticalAlignment="Center" Text="Monthly Revenue" />
                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding MonthlyRevenueColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding MonthlyRevenueStatusText}" />

                <TextBlock Grid.Row="7" Margin="0,12,12,0" VerticalAlignment="Center" Text="Utilization" />
                <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding UtilizationColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="7" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding UtilizationStatusText}" />

                <TextBlock Grid.Row="8" Margin="0,12,12,0" VerticalAlignment="Center" Text="Trips" />
                <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding TripsColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="8" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding TripsStatusText}" />

                <TextBlock Grid.Row="9" Margin="0,12,12,0" VerticalAlignment="Center" Text="Ratings / Reviews" />
                <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding RatingColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="9" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding RatingStatusText}" />

                <TextBlock Grid.Row="10" Margin="0,12,12,0" VerticalAlignment="Center" Text="Location" />
                <ComboBox Grid.Row="10" Grid.Column="1" Margin="0,12,12,0" ItemsSource="{Binding AvailableHeaders}" SelectedItem="{Binding LocationColumnSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="10" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#7A664F" Text="{Binding LocationStatusText}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="4,14,4,0"
                   Foreground="#A24B2E"
                   FontWeight="SemiBold"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="120"
                    Height="38"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    IsCancel="True" />
            <Button Width="140"
                    Height="38"
                    Click="ConfirmButton_Click"
                    Content="Confirm Import"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}" />
        </StackPanel>
    </Grid>
</Window>
